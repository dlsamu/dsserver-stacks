#!/usr/sbin/nft -f
# Beacon host firewall (/srv/stacks/beacon/firewall). Replaces only this table; never `flush ruleset`
# (Docker keeps its own tables). Incoming from the home LAN: SSH, HTTPS (443, Caddy -> dashboard) and mDNS.
# Beszel hub 8090 (plain HTTP): only the dsserver agent (192.168.68.115); Beacon's own agent and Caddy use loopback.
# HTTPS cutover 2026-11-11 (docs/https.md). Outgoing is not filtered. Containers here use host or no networking, so no forward rules are needed.
table inet beacon_fw
delete table inet beacon_fw
table inet beacon_fw {
    set lan4 { type ipv4_addr; flags interval; elements = { 192.168.68.0/24 } }
    chain input {
        type filter hook input priority -10; policy drop;
        iif lo accept
        ct state established,related accept
        ct state invalid drop
        # ICMP: ping from the LAN; errors arrive as "related" above
        ip saddr @lan4 icmp type echo-request accept
        icmpv6 type { nd-neighbor-solicit, nd-neighbor-advert, nd-router-advert, nd-redirect, packet-too-big, mld-listener-query } accept
        ip6 saddr fe80::/10 icmpv6 type echo-request accept
        # DHCP renewals (unicast replies to the client port)
        udp sport 67 udp dport 68 accept
        ip6 saddr fe80::/10 udp sport 547 udp dport 546 accept
        # Access scope: home LAN
        ip saddr @lan4 tcp dport { 22, 443 } accept
        # Beszel agent WebSocket from dsserver; browsers use https://beacon.rubusdua.net
        ip saddr 192.168.68.115 tcp dport 8090 accept
        ip saddr @lan4 udp dport 5353 accept
        ip6 saddr fe80::/10 udp dport 5353 accept
        meta pkttype { broadcast, multicast } drop
        limit rate 6/minute burst 10 packets log prefix "beacon-fw drop: " level info
    }
}
