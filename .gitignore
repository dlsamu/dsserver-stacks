# Secrets and per-host values: never committed (they're covered by the encrypted backup instead)
**/.env
**/.env.*
!**/.env.example
**/secrets/

# Output from the host scripts when run inside the repo (logs, port snapshots)
host/scripts/*.log
host/scripts/ports-*.txt

# Beacon OS images (large, downloadable; verified by flash-sd.sh)
beacon/images/*.img.xz
