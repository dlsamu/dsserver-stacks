[Unit]
Description=StockPulse screener %i (container run)
Documentation=file:///srv/stacks/stockpulse/README.md
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
# exec, not oneshot: a failed oneshot never has an ActiveEnterTimestamp, and the Beszel agent skips such
# units, so a failure would not reach the SystemdFailed alert (ntfy).
Type=exec
ExecStart=/usr/local/lib/dsserver-admin/host/scripts/15-stockpulse.sh job %i
RuntimeMaxSec=55min
