[Unit]
Description=StockPulse intl screener, weekdays 09:00 (Europe/Stockholm)

[Timer]
OnCalendar=Mon..Fri 09:00 Europe/Stockholm
Unit=stockpulse-job@intl.service
AccuracySec=1min
# No catch-up after downtime (same as the Pi's cron): a missed run is skipped, not run late.
Persistent=false

[Install]
WantedBy=timers.target
