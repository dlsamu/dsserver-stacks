[Unit]
Description=StockPulse history.db backup (SQLite backup API + integrity check, 14 kept)
Requires=docker.service
After=docker.service

[Service]
# exec, not oneshot: a failed oneshot never has an ActiveEnterTimestamp, and the Beszel agent skips such
# units, so a failure would not reach the SystemdFailed alert (ntfy).
Type=exec
RuntimeMaxSec=75min
ExecStart=/usr/local/lib/dsserver-admin/host/scripts/15-stockpulse.sh backup
