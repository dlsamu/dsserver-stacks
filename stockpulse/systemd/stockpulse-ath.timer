[Unit]
Description=StockPulse ath screener, weekdays 10:00 (Europe/Stockholm)

[Timer]
OnCalendar=Mon..Fri 10:00 Europe/Stockholm
Unit=stockpulse-job@ath.service
AccuracySec=1min
# No catch-up after downtime (same as the Pi's cron): a missed run is skipped, not run late.
Persistent=false

[Install]
WantedBy=timers.target
